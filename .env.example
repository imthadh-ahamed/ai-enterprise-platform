# ============================================================
# ENVIRONMENT CONFIGURATION — COPY TO .env.local
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# ── API Gateway ───────────────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_APP_NAME="Enterprise AI Platform"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3001

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://platform_user:platform_password@localhost:5432/ai_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_platform
DB_USER=platform_user
DB_PASSWORD=platform_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CACHE_TTL=3600

# ── Vector Store (pgvector) ────────────────────────────────────
VECTOR_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.75

# ── AI Models ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=org-your-org-id
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ── Agent Service ─────────────────────────────────────────────
AGENT_SERVICE_PORT=3002
AGENT_SERVICE_URL=http://agent-service:3002
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_MS=60000
LANGGRAPH_CHECKPOINTER=redis

# ── RAG Service ───────────────────────────────────────────────
RAG_SERVICE_PORT=3003
RAG_SERVICE_URL=http://rag-service:3003
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
COHERE_API_KEY=your-cohere-key-for-reranking

# ── Document Service ──────────────────────────────────────────
DOCUMENT_SERVICE_PORT=3004
DOCUMENT_SERVICE_URL=http://document-service:3004
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,xlsx,txt,md,csv

# ── Embedding Service ─────────────────────────────────────────
EMBEDDING_SERVICE_PORT=3005
EMBEDDING_SERVICE_URL=http://embedding-service:3005

# ── MCP Gateway ───────────────────────────────────────────────
MCP_GATEWAY_PORT=3006
MCP_GATEWAY_URL=http://mcp-gateway:3006
MCP_AUTH_SECRET=your-mcp-auth-secret

# ── Notification Service ──────────────────────────────────────
NOTIFICATION_SERVICE_PORT=3007
NOTIFICATION_SERVICE_URL=http://notification-service:3007

# ── Audit Service ─────────────────────────────────────────────
AUDIT_SERVICE_PORT=3008
AUDIT_SERVICE_URL=http://audit-service:3008

# ── MCP — GitHub ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_your-github-token
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ── MCP — Jira ────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-token

# ── MCP — Confluence ──────────────────────────────────────────
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=your@email.com
CONFLUENCE_API_TOKEN=your-confluence-token

# ── MCP — Slack ───────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=ai-platform-documents
S3_BUCKET_REGION=us-east-1

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ai-enterprise-platform
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3100
LOKI_URL=http://loki:3100

# ── Security ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_MCP=true
ENABLE_MULTI_AGENT=true
ENABLE_HUMAN_IN_LOOP=true
ENABLE_AUDIT_LOG=true
